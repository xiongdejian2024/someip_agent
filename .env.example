# 服务监听
SOMEIP_AGENT_HOST=127.0.0.1
SOMEIP_AGENT_PORT=8765
SOMEIP_AGENT_LOG_LEVEL=INFO
SOMEIP_AGENT_DATA_DIR=./data

# OpenAI 兼容网关。密钥只能通过环境变量或设置页写入系统凭据库。
SOMEIP_AGENT_LLM_BASE_URL=https://voyahgpt-gateway.voyah.cn/api/gateway/v1
SOMEIP_AGENT_LLM_API_KEY=
SOMEIP_AGENT_LLM_MODEL=qwen3.5-plus
SOMEIP_AGENT_LLM_TIMEOUT_SECONDS=60
SOMEIP_AGENT_LLM_TEMPERATURE=0.1

# 在线升级。生产环境应配置 HTTPS 清单地址与 Ed25519 公钥。
SOMEIP_AGENT_UPDATE_MANIFEST_URL=
SOMEIP_AGENT_UPDATE_PUBLIC_KEY=
# 发行版自动确定安装目录和独立升级器；开发环境不允许假装执行安装。
# SOMEIP_AGENT_UPDATE_INSTALL_ROOT=
# SOMEIP_AGENT_UPDATE_HELPER_BINARY=

# 原生仿真必须提供本机可执行的 vsomeip 桥接二进制；缺少时明确返回不可用，不退回 Python 发包。
SOMEIP_AGENT_NATIVE_BINARY=soa_partner
# 真实网络模式设置为本机测试网卡 IPv4；内部模式强制只用回环并关闭 SD 组播。
SOMEIP_AGENT_NATIVE_UNICAST=127.0.0.1

# 安全策略：默认仅模拟，不向真实网络发包。
SOMEIP_AGENT_NETWORK_SEND_ENABLED=false
SOMEIP_AGENT_ALLOWED_DESTINATIONS=[]
SOMEIP_AGENT_MAX_UPLOAD_BYTES=268435456
