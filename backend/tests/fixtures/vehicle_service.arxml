<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00048.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>DataTypes</SHORT-NAME>
      <ELEMENTS>
        <SW-BASE-TYPE>
          <SHORT-NAME>UnsignedWord</SHORT-NAME>
          <CATEGORY>FIXED_LENGTH</CATEGORY>
          <BASE-TYPE-SIZE>16</BASE-TYPE-SIZE>
          <BASE-TYPE-ENCODING>NONE</BASE-TYPE-ENCODING>
        </SW-BASE-TYPE>
        <SW-BASE-TYPE>
          <SHORT-NAME>UnsignedByte</SHORT-NAME>
          <CATEGORY>FIXED_LENGTH</CATEGORY>
          <BASE-TYPE-SIZE>8</BASE-TYPE-SIZE>
          <BASE-TYPE-ENCODING>NONE</BASE-TYPE-ENCODING>
        </SW-BASE-TYPE>
        <SW-BASE-TYPE>
          <SHORT-NAME>LogicalByte</SHORT-NAME>
          <CATEGORY>FIXED_LENGTH</CATEGORY>
          <BASE-TYPE-SIZE>8</BASE-TYPE-SIZE>
          <BASE-TYPE-ENCODING>BOOLEAN</BASE-TYPE-ENCODING>
        </SW-BASE-TYPE>
        <SW-BASE-TYPE>
          <SHORT-NAME>RealSingle</SHORT-NAME>
          <CATEGORY>FIXED_LENGTH</CATEGORY>
          <BASE-TYPE-SIZE>32</BASE-TYPE-SIZE>
          <BASE-TYPE-ENCODING>IEEE754</BASE-TYPE-ENCODING>
        </SW-BASE-TYPE>
        <IMPLEMENTATION-DATA-TYPE>
          <SHORT-NAME>uint16_kph</SHORT-NAME>
          <CATEGORY>VALUE</CATEGORY>
          <SW-DATA-DEF-PROPS><SW-DATA-DEF-PROPS-VARIANTS><SW-DATA-DEF-PROPS-CONDITIONAL>
            <BASE-TYPE-REF>/DataTypes/UnsignedWord</BASE-TYPE-REF>
          </SW-DATA-DEF-PROPS-CONDITIONAL></SW-DATA-DEF-PROPS-VARIANTS></SW-DATA-DEF-PROPS>
        </IMPLEMENTATION-DATA-TYPE>
        <IMPLEMENTATION-DATA-TYPE>
          <SHORT-NAME>uint8</SHORT-NAME>
          <CATEGORY>VALUE</CATEGORY>
          <SW-DATA-DEF-PROPS><SW-DATA-DEF-PROPS-VARIANTS><SW-DATA-DEF-PROPS-CONDITIONAL>
            <BASE-TYPE-REF>/DataTypes/UnsignedByte</BASE-TYPE-REF>
          </SW-DATA-DEF-PROPS-CONDITIONAL></SW-DATA-DEF-PROPS-VARIANTS></SW-DATA-DEF-PROPS>
        </IMPLEMENTATION-DATA-TYPE>
        <IMPLEMENTATION-DATA-TYPE>
          <SHORT-NAME>boolean</SHORT-NAME>
          <CATEGORY>VALUE</CATEGORY>
          <SW-DATA-DEF-PROPS><SW-DATA-DEF-PROPS-VARIANTS><SW-DATA-DEF-PROPS-CONDITIONAL>
            <BASE-TYPE-REF>/DataTypes/LogicalByte</BASE-TYPE-REF>
          </SW-DATA-DEF-PROPS-CONDITIONAL></SW-DATA-DEF-PROPS-VARIANTS></SW-DATA-DEF-PROPS>
        </IMPLEMENTATION-DATA-TYPE>
        <IMPLEMENTATION-DATA-TYPE>
          <SHORT-NAME>float32_kph</SHORT-NAME>
          <CATEGORY>VALUE</CATEGORY>
          <SW-DATA-DEF-PROPS><SW-DATA-DEF-PROPS-VARIANTS><SW-DATA-DEF-PROPS-CONDITIONAL>
            <BASE-TYPE-REF>/DataTypes/RealSingle</BASE-TYPE-REF>
          </SW-DATA-DEF-PROPS-CONDITIONAL></SW-DATA-DEF-PROPS-VARIANTS></SW-DATA-DEF-PROPS>
        </IMPLEMENTATION-DATA-TYPE>
      </ELEMENTS>
    </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>Interfaces</SHORT-NAME>
      <ELEMENTS>
        <SERVICE-INTERFACE>
          <SHORT-NAME>VehicleStatus</SHORT-NAME>
          <METHODS>
            <CLIENT-SERVER-OPERATION>
              <SHORT-NAME>SetSpeed</SHORT-NAME>
              <ARGUMENTS>
                <ARGUMENT-DATA-PROTOTYPE>
                  <SHORT-NAME>Speed</SHORT-NAME>
                  <TYPE-TREF>/DataTypes/uint16_kph</TYPE-TREF>
                  <DIRECTION>IN</DIRECTION>
                </ARGUMENT-DATA-PROTOTYPE>
                <ARGUMENT-DATA-PROTOTYPE>
                  <SHORT-NAME>Accepted</SHORT-NAME>
                  <TYPE-TREF>/DataTypes/boolean</TYPE-TREF>
                  <DIRECTION>OUT</DIRECTION>
                </ARGUMENT-DATA-PROTOTYPE>
              </ARGUMENTS>
            </CLIENT-SERVER-OPERATION>
          </METHODS>
          <EVENTS>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>SpeedChanged</SHORT-NAME>
              <TYPE-TREF>/DataTypes/float32_kph</TYPE-TREF>
            </VARIABLE-DATA-PROTOTYPE>
          </EVENTS>
          <FIELDS>
            <FIELD>
              <SHORT-NAME>IgnitionState</SHORT-NAME>
              <VARIABLE-DATA-PROTOTYPE>
                <SHORT-NAME>IgnitionState</SHORT-NAME>
                <TYPE-TREF>/DataTypes/uint8</TYPE-TREF>
              </VARIABLE-DATA-PROTOTYPE>
            </FIELD>
          </FIELDS>
        </SERVICE-INTERFACE>
      </ELEMENTS>
    </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>Deployment</SHORT-NAME>
      <ELEMENTS>
        <SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
          <SHORT-NAME>VehicleStatusDeployment</SHORT-NAME>
          <SERVICE-INTERFACE-REF>/Interfaces/VehicleStatus</SERVICE-INTERFACE-REF>
          <SERVICE-INTERFACE-ID>0x1234</SERVICE-INTERFACE-ID>
          <MAJOR-VERSION>1</MAJOR-VERSION>
          <MINOR-VERSION>2</MINOR-VERSION>
          <METHOD-DEPLOYMENTS>
            <SOMEIP-METHOD-DEPLOYMENT>
              <SHORT-NAME>SetSpeedDeployment</SHORT-NAME>
              <METHOD-REF>/Interfaces/VehicleStatus/SetSpeed</METHOD-REF>
              <METHOD-ID>0x0001</METHOD-ID>
            </SOMEIP-METHOD-DEPLOYMENT>
          </METHOD-DEPLOYMENTS>
          <EVENT-DEPLOYMENTS>
            <SOMEIP-EVENT-DEPLOYMENT>
              <SHORT-NAME>SpeedChangedDeployment</SHORT-NAME>
              <EVENT-REF>/Interfaces/VehicleStatus/SpeedChanged</EVENT-REF>
              <EVENT-ID>0x8001</EVENT-ID>
            </SOMEIP-EVENT-DEPLOYMENT>
          </EVENT-DEPLOYMENTS>
          <FIELD-DEPLOYMENTS>
            <SOMEIP-FIELD-DEPLOYMENT>
              <SHORT-NAME>IgnitionStateDeployment</SHORT-NAME>
              <FIELD-REF>/Interfaces/VehicleStatus/IgnitionState</FIELD-REF>
              <GETTER-ID>0x0101</GETTER-ID>
              <SETTER-ID>0x0102</SETTER-ID>
              <NOTIFIER-ID>0x8101</NOTIFIER-ID>
            </SOMEIP-FIELD-DEPLOYMENT>
          </FIELD-DEPLOYMENTS>
          <EVENT-GROUPS>
            <SOMEIP-EVENT-GROUP>
              <SHORT-NAME>VehicleEvents</SHORT-NAME>
              <EVENT-GROUP-ID>0x0001</EVENT-GROUP-ID>
              <EVENT-REF>/Interfaces/VehicleStatus/SpeedChanged</EVENT-REF>
              <FIELD-DEPLOYMENT-REF>/Deployment/VehicleStatusDeployment/IgnitionStateDeployment</FIELD-DEPLOYMENT-REF>
            </SOMEIP-EVENT-GROUP>
          </EVENT-GROUPS>
        </SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
        <PROVIDED-SOMEIP-SERVICE-INSTANCE>
          <SHORT-NAME>VehicleStatusInstance</SHORT-NAME>
          <SERVICE-INTERFACE-DEPLOYMENT-REF>/Deployment/VehicleStatusDeployment</SERVICE-INTERFACE-DEPLOYMENT-REF>
          <SERVICE-INSTANCE-ID>0x0001</SERVICE-INSTANCE-ID>
        </PROVIDED-SOMEIP-SERVICE-INSTANCE>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
